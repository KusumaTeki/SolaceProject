PORT=4000

# Start with demo mode to test without external services.
# DEMO_MODE=true uses scripted replies and in-memory chat history.
# DEMO_MODE=false requires both MongoDB and Groq credentials.
DEMO_MODE=true

# MongoDB Atlas: replace the placeholders with your database user, password, and cluster host.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/solace?retryWrites=true&w=majority

# Keep the Groq key only in this server .env file. Never use an EXPO_PUBLIC_ prefix.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Expo web development origins. Native Android requests do not send a browser Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:8085
